# Dockerfile para Producción - Backend Node.js (SYNNER CRM)
# Multi-stage build optimizado.

FROM node:20-alpine AS builder

WORKDIR /app

# Copiar manifiestos para aprovechar la caché de dependencias
COPY package*.json ./

# Instalar TODAS las dependencias (incluye prisma CLI para generar el cliente)
RUN npm ci

# Copiar el esquema de Prisma y generar el cliente
COPY prisma ./prisma
RUN npx prisma generate

# Copiar el resto del código fuente
COPY . .

# ─── Production stage ──────────────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app
ENV NODE_ENV=production

# Copiar manifiestos e instalar solo dependencias de producción
COPY package*.json ./
RUN npm ci --omit=dev

# Copiar el Prisma Client YA generado desde el builder (evita regenerarlo)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client

# Copiar el esquema y el código de la aplicación
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src ./src
COPY --from=builder /app/public ./public

EXPOSE 3000

# Comprobación de salud del contenedor contra el endpoint /health
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["node", "src/server.js"]
