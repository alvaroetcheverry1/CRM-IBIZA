// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// MODELS
// ============================================================

// ─── Multi-Tenancy: Modelo Central de Agencia ─────────────────────────────
model Agencia {
  id            String    @id @default(cuid())
  nombre        String
  email         String    @unique
  passwordHash  String?   // Para login email+contraseña del dueño de la agencia
  plan          String    @default("TRIAL") // TRIAL | STARTER | PRO | ELITE
  estado        String    @default("PENDIENTE") // PENDIENTE | ACTIVA | SUSPENDIDA
  trialExpira   DateTime?
  telefono      String?
  pais          String?   @default("España")
  notas         String?   // Notas internas del superadmin
  activadaEn    DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  // Relaciones
  usuarios          Usuario[]
  propietarios      Propietario[]
  propiedades       Propiedad[]
  clientes          Cliente[]
  documentos        Documento[]
  actividades       Actividad[]
  contratos         ContratoMandato[]
  publicaciones     PublicacionPortal[]
  configuracion     ConfiguracionAgencia[]
  catalogos         Catalogo[]
  notificaciones    Notificacion[]
  tareas            Tarea[]
}

model Usuario {
  id            String    @id @default(cuid())
  googleId      String?   @unique
  email         String    @unique
  passwordHash  String?   // Para login email+contraseña
  nombre        String
  apellidos     String?
  avatar        String?
  rol           String    @default("AGENTE") // SUPERADMIN | DIRECTOR | AGENTE
  activo        Boolean   @default(true)
  ultimoAcceso  DateTime?
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  agenciaId   String?
  agencia     Agencia?   @relation(fields: [agenciaId], references: [id])

  propiedades Propiedad[]
  documentos  Documento[]
  actividades Actividad[]
  auditLogs   AuditLog[]
  tareas      Tarea[]
}

model Propietario {
  id                  String   @id @default(cuid())
  nombre              String
  apellidos           String
  nif                 String
  telefono            String
  telefonoAlternativo String?
  email               String
  direccion           String?
  ciudad              String?
  pais                String?  @default("España")
  iban                String?
  categoria           String   @default("ESTANDAR")
  notas               String?
  urlDriveCarpeta     String?
  activo              Boolean  @default(true)
  token               String?  @unique
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt

  agenciaId   String?
  agencia     Agencia? @relation(fields: [agenciaId], references: [id])

  propiedades Propiedad[]
  contratos   ContratoMandato[]
  documentos  Documento[]
}

model Propiedad {
  id                String   @id @default(cuid())
  referencia        String   @unique
  nombre            String
  tipo              String
  zona              String
  municipio         String?
  direccion         String?
  latitud           Decimal?
  longitud          Decimal?
  habitaciones      Int
  banos             Int
  metrosConstruidos Decimal
  metrosParcela     Decimal?
  piscina           String   @default("NO")
  garaje            Boolean  @default(false)
  trastero          Boolean  @default(false)
  ascensor          Boolean  @default(false)
  terraza           Boolean  @default(false)
  jardin            Boolean  @default(false)
  vistasMar         Boolean  @default(false)
  categoria         String   @default("ESTANDAR")
  estado            String   @default("DISPONIBLE")
  caracteristicas   String?
  descripcion       String?
  notas             String?
  urlDriveCarpeta   String?
  fotoPrincipal     String?
  fotos             String   @default("[]")
  activo            Boolean  @default(true)
  precioCompra      Decimal?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  agenciaId   String?
  agencia     Agencia?     @relation(fields: [agenciaId], references: [id])

  propietarioId String?
  propietario   Propietario? @relation(fields: [propietarioId], references: [id])
  agenteId      String?
  agente        Usuario?     @relation(fields: [agenteId], references: [id])

  alquilerVacacional    AlquilerVacacional?
  alquilerLargaDuracion AlquilerLargaDuracion?
  venta                 Venta?

  documentos       Documento[]
  actividades      Actividad[]
  auditLogs        AuditLog[]
  reservasExternas ReservaExterna[]
  publicaciones    PublicacionPortal[]
  catalogos        CatalogoPropiedad[]
  tareas           Tarea[]

  @@index([tipo, estado, zona])
  @@index([agenciaId])
}

model AlquilerVacacional {
  id          String    @id @default(cuid())
  propiedadId String    @unique
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  licenciaETV          String?
  cedula               String?
  precioTemporadaAlta  Decimal?
  precioTemporadaMedia Decimal?
  precioTemporadaBaja  Decimal?
  depositoGarantia     Decimal?
  checkInHora          String?  @default("16:00")
  checkOutHora         String?  @default("11:00")
  instruccionesLlave   String?
  minimoNoches         Int?     @default(7)
  personasMaximas      Int?
  urlAirbnb            String?
  urlBooking           String?
  urlMioweb            String?

  reservas Reserva[]
}

model Reserva {
  id                   String             @id @default(cuid())
  alquilerVacacionalId String
  alquilerVacacional   AlquilerVacacional @relation(fields: [alquilerVacacionalId], references: [id])

  clienteNombre    String
  clienteTelefono  String?
  clienteEmail     String?
  fechaEntrada     DateTime
  fechaSalida      DateTime
  noches           Int
  personas         Int?
  precioTotal      Decimal
  depositoCobrado  Boolean  @default(false)
  depositoDevuelto Boolean  @default(false)
  temporada        String
  notas            String?
  origen           String?  @default("DIRECTO")
  creadoEn         DateTime @default(now())
}

model AlquilerLargaDuracion {
  id          String    @id @default(cuid())
  propiedadId String    @unique
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  inquilinoNombre        String?
  inquilinoNif           String?
  inquilinoTelefono      String?
  inquilinoEmail         String?
  fechaInicio            DateTime?
  duracionMeses          Int?      @default(12)
  fechaVencimiento       DateTime?
  rentaMensual           Decimal?
  fianzaMeses            Int?      @default(2)
  fianzaImporte          Decimal?
  diaPagoCada            Int?      @default(1)
  ipcUltimaActualizacion DateTime?

  pagos PagoRenta[]
}

model PagoRenta {
  id                      String                @id @default(cuid())
  alquilerLargaDuracionId String
  alquilerLargaDuracion   AlquilerLargaDuracion @relation(fields: [alquilerLargaDuracionId], references: [id])

  mes        DateTime
  importe    Decimal
  estado     String    @default("PENDIENTE")
  fechaCobro DateTime?
  notas      String?
  creadoEn   DateTime  @default(now())
}

model Venta {
  id          String    @id @default(cuid())
  propiedadId String    @unique
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  precioVenta          Decimal?
  precioMinimo         Decimal?
  referenciaCatastral  String?
  numRegistroPropiedad String?
  estadoHipotecario    String   @default("LIBRE")
  comisionAgencia      Decimal?
  etapaPipeline        String   @default("CAPTACION")
  fechaArras           DateTime?
  fechaEscritura       DateTime?
  notario              String?
  observaciones        String?
}

model Cliente {
  id              String   @id @default(cuid())
  nombre          String
  apellidos       String?
  telefono        String?
  email           String?
  tipo            String   @default("AMBOS")
  estado          String   @default("NUEVO")
  presupuesto     Decimal?
  zonaInteres     String?
  habitacionesMin Int?
  habitacionesMax Int?
  notas           String?
  origen          String?
  urlDriveCarpeta String?
  activo          Boolean  @default(true)
  scoreIA         Int?
  fechaPrimerContacto DateTime?
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  agenciaId   String?
  agencia     Agencia? @relation(fields: [agenciaId], references: [id])

  actividades      Actividad[]
  documentos       Documento[]
  mensajesWhatsApp MensajeWhatsApp[]
  tareas           Tarea[]
}

model ContratoMandato {
  id            String      @id @default(cuid())
  propietarioId String
  propietario   Propietario @relation(fields: [propietarioId], references: [id])

  fechaFirma       DateTime?
  duracionMeses    Int?      @default(12)
  fechaVencimiento DateTime?
  exclusividad     Boolean   @default(false)
  comisionVenta    Decimal?
  comisionAlquiler Decimal?
  urlDocumento     String?
  notas            String?
  creadoEn         DateTime  @default(now())

  agenciaId   String?
  agencia     Agencia? @relation(fields: [agenciaId], references: [id])
}

model Documento {
  id                  String  @id @default(cuid())
  nombre              String
  tipo                String  @default("OTRO")
  mimeType            String?
  tamanoBytes         Int?
  urlDrive            String?
  driveFileId         String?
  estadoProcesamiento String  @default("PENDIENTE")
  datosExtraidos      String?
  errorProcesamiento  String?

  agenciaId     String?
  agencia       Agencia?     @relation(fields: [agenciaId], references: [id])

  propiedadId   String?
  propiedad     Propiedad?   @relation(fields: [propiedadId], references: [id])
  propietarioId String?
  propietario   Propietario? @relation(fields: [propietarioId], references: [id])
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  subidoPorId   String?
  subidoPor     Usuario?     @relation(fields: [subidoPorId], references: [id])

  creadoEn DateTime @default(now())
}

model Actividad {
  id          String   @id @default(cuid())
  tipo        String
  descripcion String
  fecha       DateTime @default(now())

  agenciaId   String?
  agencia     Agencia?   @relation(fields: [agenciaId], references: [id])

  propiedadId String?
  propiedad   Propiedad? @relation(fields: [propiedadId], references: [id])
  clienteId   String?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id])
  usuarioId   String?
  usuario     Usuario?   @relation(fields: [usuarioId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  accion    String
  entidad   String
  entidadId String
  datos     String?
  ip        String?
  fecha     DateTime @default(now())

  usuarioId   String?
  usuario     Usuario?   @relation(fields: [usuarioId], references: [id])
  propiedadId String?
  propiedad   Propiedad? @relation(fields: [propiedadId], references: [id])
}

model ReservaExterna {
  id          String   @id @default(cuid())
  uid         String
  origen      String
  fechaInicio DateTime
  fechaFin    DateTime
  titulo      String?
  syncedAt    DateTime @default(now())

  propiedadId String
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@unique([uid, propiedadId])
}

model PublicacionPortal {
  id          String    @id @default(cuid())
  propiedadId String
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  agenciaId String?
  agencia   Agencia? @relation(fields: [agenciaId], references: [id])

  portal           String
  estado           String    @default("NO_PUBLICADO")
  urlPublicacion   String?
  idExterno        String?
  errores          String?
  ultimoSync       DateTime?
  fechaPublicacion DateTime?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  @@unique([propiedadId, portal])
  @@index([portal, estado])
}

model MensajeWhatsApp {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rol       String
  contenido String
  creadoEn  DateTime @default(now())

  @@index([clienteId])
}

model ConfiguracionAgencia {
  id              String  @id @default(cuid())
  nombreLegal     String?
  nombreComercial String?
  cif             String?
  direccion       String?
  telefonoOficial String?
  whatsapp        String?
  emailOficial    String?
  logoUrl         String?
  watermarkUrl    String?
  firmaUrl        String?
  iban            String?
  colorPrincipal  String? @default("#1890ff")
  webUrl          String?
  instagram       String?
  facebook        String?
  linkedin        String?
  idiomaPrincipal String? @default("es")
  tokensPortales    String?
  configFacturacion String?

  agenciaId String?
  agencia   Agencia? @relation(fields: [agenciaId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Catalogo {
  id            String    @id @default(cuid())
  agenciaId     String
  agencia       Agencia   @relation(fields: [agenciaId], references: [id])
  nombre        String
  token         String    @unique
  vistas        Int       @default(0)
  ultimoAcceso  DateTime?
  expiraEn      DateTime?
  creadoEn      DateTime  @default(now())
  
  propiedades   CatalogoPropiedad[]
}

model CatalogoPropiedad {
  id          String    @id @default(cuid())
  catalogoId  String
  catalogo    Catalogo  @relation(fields: [catalogoId], references: [id], onDelete: Cascade)
  propiedadId String
  propiedad   Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  
  @@unique([catalogoId, propiedadId])
}

model Notificacion {
  id        String   @id @default(cuid())
  tipo      String   // INFO | ALERTA | NUEVO_LEAD | IMPAGO | VENCIMIENTO
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  enlace    String?
  creadoEn  DateTime @default(now())

  agenciaId String?
  agencia   Agencia? @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
}

model Tarea {
  id               String   @id @default(cuid())
  titulo           String
  descripcion      String?
  fechaVencimiento DateTime
  tipo             String   @default("VISITA") // VISITA | LLAMADA | EMAIL | REUNION | OTRO
  completada       Boolean  @default(false)
  prioridad        String   @default("MEDIA") // BAJA | MEDIA | ALTA
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  agenciaId   String?
  agencia     Agencia?   @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  clienteId   String?
  cliente     Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  propiedadId String?
  propiedad   Propiedad? @relation(fields: [propiedadId], references: [id], onDelete: SetNull)
  usuarioId   String?
  usuario     Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}
