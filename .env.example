# ==============================================
# CRM INMOBILIARIO PROFESIONAL — Variables de Entorno (Producción)
# Copia este archivo como .env y rellena tus valores
# ==============================================

# --- Servidor y Entorno ----------------------------------
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://tu-crm.com
PUBLIC_SERVER_URL=https://api.tu-crm.com
VITE_API_URL=https://api.tu-crm.com

# --- Base de Datos (Supabase recomendado) ----------------
DATABASE_URL="postgresql://user:password@pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.supabase.com:5432/postgres"

# --- Seguridad -------------------------------------------
JWT_SECRET=tu-llave-secreta-de-produccion-muy-larga-y-aleatoria

# --- Google OAuth 2.0 ------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.tu-crm.com/api/auth/google/callback

# --- Google Drive API v3 ---------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=id_carpeta_drive

# --- Google Sheets API v4 --------------------------------
GOOGLE_SHEET_MASTER_ID=id_hoja_calculo_master
GOOGLE_SHEETS_VACACIONAL_ID=id_del_sheet_alquiler_vacacional
GOOGLE_SHEETS_LARGA_DURACION_ID=id_del_sheet_alquiler_larga_duracion
GOOGLE_SHEETS_VENTA_ID=id_del_sheet_venta
GOOGLE_SHEETS_PROPIETARIOS_ID=id_del_sheet_propietarios
GOOGLE_SHEETS_CLIENTES_ID=id_del_sheet_clientes

# --- Inteligencia Artificial (OpenAI) --------------------
# Obligatoria para extracción de dossiers PDF y Matchmaking
OPENAI_API_KEY=sk-proj-...

# --- WhatsApp Business API -------------------------------
# Solo si usas el agente de WhatsApp automático
WHATSAPP_TOKEN=token_meta
WHATSAPP_PHONE_ID=id_telefono
WHATSAPP_VERIFY_TOKEN=token_verificacion_webhook

# --- Email (SendGrid) ------------------------------------
SENDGRID_API_KEY=SG.tu_api_key_sendgrid
FROM_EMAIL=crm@tuagencia.com
