# ==============================================
# SYNNER · CRM Inmobiliario — Variables de Entorno
# Copia este archivo como .env y rellena tus valores.
# NUNCA subas el .env real a git (ya está en .gitignore).
# ==============================================

# --- Servidor y Entorno ----------------------------------
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://tu-crm.com
# Orígenes CORS adicionales permitidos, separados por comas (ej. dominios de agencias).
CORS_EXTRA_ORIGINS=https://app.synner.com,https://www.synner.com
# URL pública del backend. Necesaria para que portales y el frontend
# resuelvan las imágenes servidas en /api/uploads y los feeds XML.
PUBLIC_SERVER_URL=https://api.tu-crm.com
VITE_API_URL=https://api.tu-crm.com

# --- Base de Datos (Supabase / PostgreSQL) ---------------
DATABASE_URL="postgresql://user:password@pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.supabase.com:5432/postgres"

# --- Marca de la plataforma ------------------------------
BRAND_NAME=SYNNER
BRAND_TAGLINE=The intelligent CRM
# Email donde el superadmin recibe avisos de nuevas agencias pendientes.
ADMIN_NOTIFICATION_EMAIL=

# --- Seguridad -------------------------------------------
# Cadena larga y aleatoria. Genera con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-llave-larga-y-aleatoria

# --- Google OAuth 2.0 ------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.tu-crm.com/api/auth/google/callback

# --- Google Drive API v3 (opcional) ----------------------
# Si no se configura, los archivos caen a Supabase Storage o a disco local.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=id_carpeta_drive

# --- Google Sheets API v4 (opcional) ---------------------
GOOGLE_SHEET_MASTER_ID=id_hoja_calculo_master
GOOGLE_SHEETS_VACACIONAL_ID=
GOOGLE_SHEETS_LARGA_DURACION_ID=
GOOGLE_SHEETS_VENTA_ID=

# --- Supabase Storage (CDN de imágenes/documentos) -------
# Si faltan, la subida de archivos hace fallback a disco local (/api/uploads).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Inteligencia Artificial (OpenAI) --------------------
# Sin esta clave, la extracción de dossiers funciona en modo degradado
# (regex + OCR) sin GPT-4o Vision.
OPENAI_API_KEY=sk-proj-...

# --- Scraper (Apify, opcional) ---------------------------
# Sin token, el agente captador funciona en modo simulación.
APIFY_API_TOKEN=

# --- WhatsApp Business API (Meta, opcional) --------------
WHATSAPP_TOKEN=token_meta
WHATSAPP_PHONE_ID=id_telefono
WHATSAPP_VERIFY_TOKEN=token_verificacion_webhook
# Secreto de la app de Meta, usado para verificar la firma del webhook.
# Si se define, el webhook rechaza peticiones sin firma HMAC válida.
WHATSAPP_APP_SECRET=
# Agencia a la que se asignan los leads entrantes por WhatsApp (multi-tenant).
WHATSAPP_DEFAULT_AGENCIA_ID=

# --- Portales Inmobiliarios (opcional) -------------------
# Token que protege el feed público XML.
PORTALES_FEED_TOKEN=
JAMES_EDITION_API_KEY=
JAMES_EDITION_AGENCY_ID=
IDEALISTA_FEED_URL=
FOTOCASA_FEED_URL=

# --- Email (SMTP / Nodemailer) ---------------------------
# Sin estos valores, los emails se registran en consola (modo test).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-email@dominio.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM="SYNNER <no-reply@tu-crm.com>"

# --- Pagos (Stripe, opcional) ----------------------------
# Sin STRIPE_SECRET_KEY los pagos quedan deshabilitados (rutas devuelven 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_PREMIUM=
