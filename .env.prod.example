# ==============================================
# SYNNER CRM — Variables de Entorno (PRODUCCIÓN)
# Copia como .env y rellena con valores reales. NUNCA lo subas a git.
# ==============================================

# --- Servidor y Entorno ----------------------------------
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.synner.com
PUBLIC_SERVER_URL=https://api.synner.com
VITE_API_URL=https://api.synner.com
# Orígenes CORS adicionales (dominios de la app/web), separados por comas.
CORS_EXTRA_ORIGINS=https://app.synner.com,https://www.synner.com

# --- Marca de la plataforma ------------------------------
BRAND_NAME=SYNNER
BRAND_TAGLINE=The intelligent CRM
# Email donde el superadmin recibe avisos de nuevas agencias pendientes.
ADMIN_NOTIFICATION_EMAIL=admin@synner.com

# --- Base de Datos (Supabase / PostgreSQL) ---------------
DATABASE_URL="postgresql://user:password@pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db.supabase.com:5432/postgres"

# --- Seguridad -------------------------------------------
# Genera con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-llave-larga-y-aleatoria-de-produccion

# --- Google OAuth 2.0 (opcional, SSO) --------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.synner.com/api/auth/google/callback

# --- Google Drive / Sheets (opcional) --------------------
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=id_carpeta_drive_produccion
GOOGLE_SHEET_MASTER_ID=id_hoja_calculo_master

# --- Supabase Storage (CDN de imágenes/documentos) -------
# Si falta, la subida de archivos hace fallback a disco local (/api/uploads).
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Inteligencia Artificial (OpenAI) --------------------
OPENAI_API_KEY=sk-proj-tu-api-key-openai

# --- Scraper (Apify, opcional) ---------------------------
APIFY_API_TOKEN=

# --- WhatsApp Business API (por agencia, opcional global) -
# Estas variables son el fallback global; cada agencia puede definir las suyas
# en su configuración (Configuración → WhatsApp / Integraciones).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=synner_whatsapp_webhook
WHATSAPP_APP_SECRET=
# Agencia a la que se asignan los leads entrantes por el número global.
WHATSAPP_DEFAULT_AGENCIA_ID=

# --- Portales Inmobiliarios (Feeds XML) ------------------
PORTALES_FEED_TOKEN=tu_token_secreto_para_feeds
JAMES_EDITION_API_KEY=
JAMES_EDITION_AGENCY_ID=
IDEALISTA_FEED_URL=
FOTOCASA_FEED_URL=

# --- Email (SMTP / Nodemailer) ---------------------------
# Sin estos valores, los emails se registran en consola (modo test).
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=465
SMTP_USER=no-reply@synner.com
SMTP_PASS=tu-password-o-app-password
SMTP_FROM="SYNNER <no-reply@synner.com>"

# --- Logging ---------------------------------------------
LOG_LEVEL=info

# --- Pagos (Stripe) — Fase 6, aún no implementado --------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
