# En producción el frontend llama DIRECTAMENTE al backend de Render.
# Antes se usaba /api + rewrite de vercel.json, pero el proxy de Vercel limita
# el cuerpo de las peticiones a ~4,5 MB y cortaba las subidas de archivos
# ("muy largo"). Yendo directo a Render el límite real es el de multer (50 MB).
# Requiere que CORS_EXTRA_ORIGINS en Render incluya https://crm-ibiza.vercel.app
VITE_API_URL=https://crm-ibiza.onrender.com/api
